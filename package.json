{
  "name": "glyphary",
  "version": "0.1.1",
  "description": "Local icon font viewer: drop an SVG font, WOFF, WOFF2, TTF or OTF and read every glyph, code point and CSS rule.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "glyphary": "bin/glyphary.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "index.html",
    "dist/glyphary.html",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-standalone.mjs",
    "build:app": "vite build",
    "preview": "vite preview",
    "start": "node bin/glyphary.mjs",
    "serve": "node bin/glyphary.mjs --serve",
    "shots": "node scripts/screenshots.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "desktop:frontend": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:icon": "tauri icon src-tauri/icons/icon.svg",
    "release": "node scripts/release.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "icon-font",
    "svg-font",
    "woff",
    "woff2",
    "glyph",
    "glyphary",
    "codepoints"
  ],
  "dependencies": {
    "fontkit": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
