{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glyphary",
  "version": "../package.json",
  "identifier": "com.pedroaccrivera.glyphary",
  "build": {
    "beforeDevCommand": "npm run desktop:frontend",
    "beforeBuildCommand": "npm run desktop:frontend",
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glyphary",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 32 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "© 2026 Pedro Rivera",
    "shortDescription": "Local icon font viewer",
    "longDescription": "Open an icon font, read every glyph, code point and CSS rule. Everything stays on your machine.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "signingIdentity": "-"
    }
  }
}
